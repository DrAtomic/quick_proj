#!/bin/bash

set -xe

proj_dir=~/Projects

if [[ "$1" == "gui" ]]
then
    if [ -d  "$proj_dir/$2" ]
    then
	echo "project already exists"
	exit
    fi
    mkdir $proj_dir/$2
    cp -r $proj_dir/quick_proj/gui/* $proj_dir/$2
    pushd $proj_dir/$2
    sed -i "s/app_name/${2}/g" Makefile
    mv {,.}gitignore
    sed -i "s/app_name/${2}/g" .gitignore
    popd
else
    echo "failed to make project"
fi
